{
  "name": "star-stack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:smoke": "node scripts/api-smoke.mjs",
    "db:verify-backup": "node server/verify-backup.js",
    "test:release": "node scripts/release-check.mjs",
    "stress": "node scripts/stress-test.mjs",
    "test:watch": "vitest",
    "preview": "vite preview",
    "audit": "node scripts/audit.mjs",
    "audit:deps": "node scripts/dependency-audit.mjs",
    "audit:light": "node scripts/audit.mjs --theme light",
    "audit:dark": "node scripts/audit.mjs --theme dark",
    "audit:custom": "node scripts/audit.mjs --url"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "cookie": "^1.1.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.28",
    "lucide-react": "^1.31.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "7.18.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "dompurify": "3.4.12"
  }
}
