# SS-AUTH-003 production names only. Never put values in Git.
HYDRA_POSTGRES_PASSWORD=
HYDRA_SYSTEM_SECRET=
HYDRA_COOKIE_SECRET=
OIDC_TOKEN_HOOK_SECRET=
OIDC_LOGOUT_BROKER_SECRET=
JIEYA_OIDC_CLIENT_SECRET=

HYDRA_PUBLIC_PORT=4444
HYDRA_ADMIN_PORT=4445
OIDC_TOKEN_HOOK_URL=http://host.docker.internal:5175/internal/oidc/token-hook
IDENTITY_HOOK_SUBNET=172.30.40.0/29
IDENTITY_HOOK_GATEWAY_IP=172.30.40.1
IDENTITY_HYDRA_HOOK_IP=172.30.40.2
# Set only after proving the host Nginx -> Hydra source is the explicit hook
# gateway. It must equal IDENTITY_HOOK_GATEWAY_IP/32; never use 0.0.0.0/0.
IDENTITY_PROXY_CIDR=

POSTGRES_TLS_CERT_FILE=/etc/starstack/identity/postgres/server.crt
POSTGRES_TLS_KEY_FILE=/etc/starstack/identity/postgres/server.key
POSTGRES_TLS_CA_FILE=/etc/starstack/identity/postgres/ca.crt
