# Render all placeholders from read-only server discovery. The listener is the
# explicit internal identity-hook gateway, never 0.0.0.0 or a public interface.
server {
    listen __IDENTITY_HOOK_GATEWAY_IP__:5175;
    server_name _;
    access_log off;
    server_tokens off;
    client_max_body_size 16k;

    allow __IDENTITY_HYDRA_HOOK_IP__/32;
    deny all;

    location = /internal/oidc/token-hook {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:5174;
        proxy_set_header Host auth.xingzhan.cc;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_send_timeout 5s;
        proxy_buffering off;
        add_header X-StarStack-Hook-Route private always;
    }

    location / {
        return 404;
    }
}
