# Host-side bridge for an all-internal Hydra container. Install this only in
# the Nginx http context; never include it from a public server block.
server {
    listen 127.0.0.1:__HYDRA_PUBLIC_PORT__;
    server_name _;
    server_tokens off;
    access_log off;
    client_max_body_size 64k;

    location / {
        allow 127.0.0.1;
        deny all;
        proxy_http_version 1.1;
        proxy_pass http://__IDENTITY_HYDRA_HOOK_IP__:4444;
        proxy_set_header Host auth.xingzhan.cc;
        proxy_set_header X-Forwarded-Host auth.xingzhan.cc;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For 127.0.0.1;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 2s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_buffering off;
    }
}

server {
    listen 127.0.0.1:__HYDRA_ADMIN_PORT__;
    server_name _;
    server_tokens off;
    access_log off;
    client_max_body_size 1m;

    location / {
        allow 127.0.0.1;
        deny all;
        proxy_http_version 1.1;
        proxy_pass http://__IDENTITY_HYDRA_HOOK_IP__:4445;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header X-Forwarded-For 127.0.0.1;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 2s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_buffering off;
    }
}
