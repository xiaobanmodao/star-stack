# SS-AUTH-003 production-equivalent staging names only. Secrets must be
# independent from production and from the local development fixture.
HYDRA_POSTGRES_PASSWORD=
HYDRA_SYSTEM_SECRET=
HYDRA_COOKIE_SECRET=
OIDC_TOKEN_HOOK_SECRET=
OIDC_LOGOUT_BROKER_SECRET=
JIEYA_OIDC_CLIENT_SECRET=

HYDRA_PUBLIC_PORT=4544
HYDRA_ADMIN_PORT=4545
OIDC_TOKEN_HOOK_URL=http://host.docker.internal:5175/internal/oidc/token-hook
IDENTITY_HOOK_SUBNET=172.30.40.8/29
IDENTITY_HOST_GATEWAY_IP=172.17.0.1
IDENTITY_HYDRA_HOOK_IP=172.30.40.10
IDENTITY_PROXY_CIDR=

POSTGRES_TLS_CERT_FILE=/etc/starstack/identity-staging/postgres/server.crt
POSTGRES_TLS_KEY_FILE=/etc/starstack/identity-staging/postgres/server.key
POSTGRES_TLS_CA_FILE=/etc/starstack/identity-staging/postgres/ca.crt
